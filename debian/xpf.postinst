#!/bin/sh
# xpf postinst (increment A of #1917).
#
# Increment A is packaging-only. The in-place upgrade cut-over
# mechanism (staged -> runtime versioned dir copy, verify-dataplane
# gate, atomic symlink flip, HA rolling failover, rollback) is a
# separate increment and is intentionally NOT implemented here.
#
# dpkg installs the binary set to the dpkg-static staging path
# /usr/local/share/xpf/staged/. The running daemon resolves its
# binaries via /usr/local/sbin/* which are SYMLINKS into the staging
# path. On FIRST install (no previously configured version) we create
# those symlinks so xpfd actually runs. On UPGRADE we deliberately
# leave the live symlinks untouched: a plain `apt upgrade xpf` only
# refreshes the staging path and must never cut the dataplane. The
# verified cut-over is driven explicitly by the increment-B mechanism.
#
# ACCEPTED increment-A limitation (plan §6.3a): because the live symlinks
# in increment A point straight at the staging path, after a plain
# `apt upgrade xpf` a SUBSEQUENT xpfd restart/reboot starts the new
# version without the verify-gated cut, and a running old xpfd that
# respawns its helper would resolve the NEW helper (protocol mismatch).
# Increment B closes this window structurally (stage->runtime versioned
# dir + atomic symlink flip behind a verify gate, or versioned ExecStart).
# Until then the operator-facing guidance is: do not `apt upgrade xpf` a
# live HA node out-of-band; use the increment-B cut-over.

set -e

STAGED=/usr/local/share/xpf/staged
SBIN=/usr/local/sbin
BINS="xpfd cli xpf-userspace-dp xpf-day0-config"

case "$1" in
    configure)
        # $2 is the previously-configured version, empty on first install.
        if [ -z "$2" ]; then
            mkdir -p "$SBIN"
            for b in $BINS; do
                # First install: point the live path at the staged binary.
                # ln -sfnT replaces a pre-existing symlink atomically and,
                # crucially, FAILS (under set -e) rather than nesting a
                # symlink INSIDE the target if it happens to be a real
                # directory — a directory at /usr/local/sbin/xpfd would
                # otherwise leave the daemon unlaunchable with a "success".
                ln -sfnT "$STAGED/$b" "$SBIN/$b"
            done
        else
            # Upgrade: do NOT touch the live symlinks. Only create one that
            # is COMPLETELY absent (not even a broken symlink); never repoint
            # an existing OR dangling link. Repointing while the daemon is up
            # would let the running xpfd resolve a different-version helper,
            # and stealing a dangling link that increment-B repointed to a
            # transiently-missing /var/lib/xpf/versions/<v>/ target would
            # bypass its verify gate. -e alone follows the link (a broken
            # link reads as absent), so guard with -L too.
            for b in $BINS; do
                if [ ! -e "$SBIN/$b" ] && [ ! -L "$SBIN/$b" ]; then
                    mkdir -p "$SBIN"
                    ln -sfnT "$STAGED/$b" "$SBIN/$b"
                fi
            done
        fi
        # State under /etc/xpf (.configdb, node-id, master.key) is runtime
        # state, NOT package-owned. Do not create, seed, or modify it here.
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
