#!/bin/sh
# xpf root-partition auto-grow (#1925 Item 1, Path A).
#
# Restores the auto-grow behavior the appliance silently lost when the
# bake purged cloud-init (whose growpart + resizefs modules used to grow
# the rootfs to fill the provisioned disk). On the first boot of a
# freshly-deployed image, grow the root *partition* to fill any trailing
# free space the operator left by provisioning a disk larger than the
# 8 GiB bake (incus -d root,size=40GiB / qemu-img resize / a bigger
# libvirt volume), then grow the ext4 filesystem to match.
#
# Mechanism (Path A): growpart + resize2fs, both already present in the
# baked Ubuntu image (cloud-utils-growpart + e2fsprogs). They CANNOT
# create, reformat, shrink, or move a partition by construction — the
# lowest data-loss surface, deliberately chosen over systemd-repart
# (which would add a package and a reformat-capable repart.d surface).
#
# A/B-substrate safety (#1930): the LANE-1 A/B kernel "slots" are
# DIRECTORIES inside the single ESP partition (/boot/efi/EFI/xpf-A,
# xpf-B) plus the /etc/grub.d/09_xpf $cmdpath selector — NOT separate
# GPT partitions; kernels live in /boot. The root partition is the
# physically LAST partition in the canonical Ubuntu cloudimg layout, so
# growing it into trailing free space cannot touch the ESP, the BIOS-boot
# or /boot partitions, or any partition NUMBER (growpart only edits the
# selected partition's end). The ESP — and the A/B dirs, selectors, and
# shim/grub it holds — is a different, untouched partition.
#
# This wrapper grows ONLY the partition that backs the live root mount,
# resolved from `findmnt / ` — never a hardcoded sda1. It is invoked once
# by xpf-grow-root.service (first-boot-only via a stamp) and is a safe
# no-op on an exact-bake-size deploy: growpart returns NOCHANGE when
# there is no trailing free space, and resize2fs is a no-op when the fs
# already fills the partition.
#
# Idempotent and fail-safe: every step tolerates the "nothing to do"
# outcome; the unit, not this script, owns the first-boot stamp. The
# script always exits 0 so a transient probe failure never blocks the
# boot — the only consequence of a miss is the status-quo (root stays at
# the bake size), which a later boot's grow would still catch were the
# stamp not yet written. The unit writes the stamp ONLY on a clean exit.

set -u

log() { echo "xpf-grow-root: $*"; }

# sysfs base is overridable for the self-test (test-grow-root.sh) only; in
# production it is the real /sys/class/block. Everything else (findmnt,
# lsblk, growpart, resize2fs) is resolved from PATH, which the self-test
# shadows with mocks.
SYSFS_BLOCK="${XPF_GROW_ROOT_SYSFS:-/sys/class/block}"

# Resolve the device backing the live root mount WITHOUT assuming a bus.
# findmnt yields e.g. /dev/sda1, /dev/vda1, /dev/nvme0n1p1. Strip any
# device-mapper / overlay indirection is out of scope — plain ext4 on
# GPT is the only supported root layout (#1925 §9).
root_src=$(findmnt -no SOURCE / 2>/dev/null)
if [ -z "$root_src" ]; then
	log "could not resolve the root device from findmnt; nothing to grow"
	exit 0
fi
case "$root_src" in
/dev/*) ;;
*)
	# A non-block-device root (overlay, tmpfs, a LABEL=/UUID= that did
	# not resolve to /dev/*) is not a growable GPT partition. Skip.
	log "root source '$root_src' is not a /dev block device; nothing to grow"
	exit 0
	;;
esac

root_name=$(basename "$root_src")
part_sysfs="$SYSFS_BLOCK/$root_name/partition"
if [ ! -r "$part_sysfs" ]; then
	log "root device '$root_src' is not a partition (no $part_sysfs); nothing to grow"
	exit 0
fi
partnum=$(cat "$part_sysfs" 2>/dev/null)

# Parent disk: lsblk PKNAME gives the whole-disk kernel name (sda / vda /
# nvme0n1) for the partition, independent of the naming scheme (the
# nvme0n1p1 -> nvme0n1 vs sda1 -> sda split differs by bus).
disk=$(lsblk -no PKNAME "$root_src" 2>/dev/null | head -n1)
if [ -z "$disk" ]; then
	log "could not resolve the parent disk of '$root_src'; nothing to grow"
	exit 0
fi

log "root device $root_src (disk /dev/$disk partition $partnum) — attempting grow"

# growpart exits non-zero with "NOCHANGE" on its stderr/stdout when there
# is no trailing free space (the exact-bake-size deploy). That is success
# for us. Any other non-zero is logged but still non-fatal — a partition
# grow we could not perform must not block the boot.
gp_out=$(growpart "/dev/$disk" "$partnum" 2>&1)
gp_rc=$?
if [ "$gp_rc" -eq 0 ]; then
	log "growpart: $gp_out"
elif printf '%s' "$gp_out" | grep -qi 'NOCHANGE'; then
	log "growpart: already at full size (NOCHANGE) — no trailing free space"
else
	log "growpart returned $gp_rc (non-fatal): $gp_out"
fi

# resize2fs grows the mounted ext4 online; it is a no-op when the fs
# already fills the partition. Non-fatal on failure (status-quo).
r2_out=$(resize2fs "$root_src" 2>&1)
r2_rc=$?
if [ "$r2_rc" -eq 0 ]; then
	log "resize2fs: ${r2_out:-ok}"
else
	log "resize2fs returned $r2_rc (non-fatal): $r2_out"
fi

log "done"
exit 0
