# Incus agent activation for the xpf appliance image (#1879).
# Upstream-verbatim from incus's own images: the agent unit is pulled
# in by udev only when the incus virtio-serial port exists, so the
# image stays inert under libvirt/QEMU and any non-incus hypervisor.
SYMLINK=="virtio-ports/org.linuxcontainers.incus", TAG+="systemd", ENV{SYSTEMD_WANTS}+="incus-agent.service"
