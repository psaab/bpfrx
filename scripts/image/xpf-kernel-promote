#!/bin/sh
# xpf (#1930) — LANE-1 kernel-channel promotion gate (runs on EVERY boot).
#
# This is the early-boot half of the A4 channel (r1 Codex Critical-1: the gate
# must actually be invoked, and a REVERT must actually reboot). On an ordinary
# boot (no candidate armed) `xpfd upgrade kernel promote` is a fast no-op. On a
# candidate trial boot it runs the gate (BootCurrent==candidate slot + uname ==
# candidate + verify-dataplane PASS + forward beacon PASS):
#   exit 0 -> PROMOTED (durable BootOrder reorder already done) — continue boot.
#   exit 3 -> REVERTED (candidate failed the gate) — reboot NOW; the firmware
#             already cleared BootNext, so the reboot falls through BootOrder to
#             the known-good slot (revert() also restored it).
#   exit 1/other -> infra error — do NOT reboot-loop on a transient failure;
#             log and continue this boot (the candidate is running but
#             un-promoted, so the NEXT plain reboot still falls back to
#             known-good via the firmware-cleared BootNext). Leave the box
#             usable for diagnosis rather than bouncing it.
#
# It runs AFTER xpfd is up (the forward-beacon gate pings through the dataplane,
# which needs xpfd active) but is NOT a hard ordering dependency of xpfd (a stuck
# promote must never wedge the box): see the .service. The promotion is gated on
# verify-dataplane (the #1864 kernel verifier — structural) AND a real forward
# beacon (off-box reachability through the dataplane), so a candidate that boots
# + verifies but cannot forward is reverted, not promoted.

set -u
log() { echo "xpf-kernel-promote: $*" >&2; }

# PROMOTE_UNIT is the systemd unit this gate derives the live xpfd from. It is
# PINNED to the default, not inferred, and that pinning is enforced at BOTH
# ends (#6601 r5):
#
#   * Here, because inferring "which unit is the xpf one" is exactly the class
#     of guess this gate exists to eliminate. Scanning for
#     <something>.service.d/10-xpf-version.conf would resolve a leftover from a
#     renamed/removed unit just as readily as the live one -- the same
#     indistinguishable-leftover problem that removed the filesystem fallbacks.
#     There is no authoritative record to read instead: flip writes its drop-in
#     UNDER <unit>.service.d/ without recording the unit name anywhere.
#
#   * At ARM time, where `xpfd upgrade kernel arm` REFUSES when systemd
#     definitively reports this unit absent (CheckKernelPromotionUnit,
#     pkg/upgrade). That is the honest place to fail: the operator sees it at
#     their terminal instead of discovering at the next boot that an armed
#     candidate went unverified.
#
# `xpfd upgrade cut --unit <name>` is a supported standalone selector, and on
# such a box flip maintains <name>.service instead. The kernel channel does not
# support that layout; it says so at arm time rather than guessing here. This
# mirrors the #1983 precedent, where NewCLICluster refuses a non-default --unit
# rather than drive control against the wrong daemon.
#
# The name is kept in sync with upgrade.DefaultUnit by a drift canary
# (TestPromoteScriptUnitMatchesDefaultUnit, pkg/upgrade).
PROMOTE_UNIT="xpfd.service"

# Resolve xpfd by EXPLICIT path, never through $PATH (#6541). This is the OUTER
# hop of the promote gate: it runs as root from a systemd oneshot on a candidate
# boot and its exit status decides promote-vs-rollback, so a $PATH entry ordered
# ahead of the real location must not be able to author that decision — and even
# absent an attacker, a stale xpfd left in another PATH directory would verify
# the wrong build against the candidate kernel. (The inner hop, xpfd's own
# `verify-dataplane` exec, is resolved explicitly by resolveVerifyGateBin in
# pkg/upgrade/kernel_linux.go.)
#
# Every source below obeys one rule: UNAMBIGUOUS OR NOTHING. A source that
# cannot prove WHICH executable it is naming stays silent, because here a wrong
# answer is far worse than no answer -- it suppresses every remaining candidate
# and that binary's exit 0 AUTHORIZES the promotion (#6601 r4).
#
# AUTHORITY ORDER -- and it is an AUTHORITY order, not a search path. Never
# $PATH, and (see below) never an inference:
#
#   1. /proc/<MainPID>/exe for xpfd.service -- the KERNEL's answer for the
#      binary the live daemon is ACTUALLY executing, reached through a
#      structured integer property plus a kernel symlink. No rendered path text
#      is parsed at all, so a runtime root containing a space or a ';' cannot be
#      truncated into some other executable. The pid is bound back to the unit
#      before it is believed (see unit_main_pid_exe).
#
#   2. The ExecStart systemd has for xpfd.service. This is what the cut writes:
#      flip step 6c templates ExecStart=<VersionsDir>/<ver>/xpfd into
#      10-xpf-version.conf on every cut (pkg/upgrade/flip.go), and the shipped
#      base unit carries ExecStart=/usr/local/sbin/xpfd before the first cut. So
#      it names the live binary both pre- and post-cut, and it is a CONCRETE
#      ABSOLUTE PATH that depends on no compiled-in root -- which matters
#      because `--versions-dir` AND `--sbin-dir` are both real operator options
#      (cmd/xpfd/upgrade.go) and the cut maintains whatever was configured.
#
#   3. A LOUD REFUSAL.
#
# THERE IS DELIBERATELY NO STEP 4 (#6601 r5). No compiled-in default paths, no
# "whichever default is usable", no same-inode heuristic. Three earlier
# revisions of this gate each closed one ambiguous filesystem case and left
# another, because the question a defaults fallback is trying to answer --
# WHICH of these files is the live xpfd -- is not answerable from the
# filesystem at all once an operator has relocated a root. `--sbin-dir` and
# `--versions-dir` relocate INDEPENDENTLY, and neither relocation REMOVES what
# it left behind, so a leftover is byte-for-byte indistinguishable from a
# healthy install:
#
#   BOTH roots relocated : the old <default sbin>/xpfd symlink AND the old
#                          <default versions>/current/xpfd both survive, and
#                          that symlink still points at that runtime -- so the
#                          two "candidates" are ONE INODE, exactly like a
#                          healthy default layout. A same-inode test calls that
#                          unambiguous; it is a STALE build. (Codex r4 MAJOR-1
#                          reproduced it end to end: live_ran False,
#                          stale_ran True.)
#   ONE root relocated   : exactly one default survives, so "the only usable
#                          default" IS the stale leftover.
#   NEITHER relocated    : healthy -- and systemd answers, so the fallback was
#                          never needed here in the first place.
#
# Every branch a defaults fallback could take therefore has a relocation shape
# that makes it wrong, and the wrongness is SILENT: a stale xpfd verifies the
# CANDIDATE KERNEL against a dataplane build nobody chose, and its exit 0
# authorizes the promotion. So the rule is enforced rather than merely stated:
# no source here selects a binary from an inference that a leftover file can
# satisfy.
#
# Refusing is not a lesser outcome, it is the correct one. The refusal takes
# the same non-rebooting infra-error path as an rc=1 from the gate: the box
# stays up and diagnosable, the armed candidate stays UN-PROMOTED, and the next
# plain reboot falls through the firmware-cleared BootNext to the known-good
# slot. Nothing is lost except the guess.
#
# `-f` as well as `-x`: `test -x` is TRUE for a searchable DIRECTORY, and the
# inner hop's validateGateBin rejects a non-regular target, so both hops apply
# the same admission test rather than only claiming to. `-f` also rejects a
# DANGLING symlink (#2176).
#
# systemctl itself is $PATH-resolved, which is correct: it is a
# distribution-owned binary, unlike xpfd -- and the unit pins $PATH to the
# distribution directories, so operator-writable /usr/local/{s,}bin (which
# systemd's DEFAULT PATH ranks FIRST) cannot supply it.

NL='
'
# systemd's REAL field delimiter after `path=` in the ExecStart rendering.
ARGV_SEP=' ; argv[]='

# pid_in_unit_cgroup is TRUE when process $1 is a member of control group $2.
#
# /proc/<pid>/cgroup lines are "<hierarchy-id>:<controllers>:<path>" -- cgroup
# v2 renders a single "0::<path>" line, v1 one line per controller. Match the
# PATH field EXACTLY (or as the parent of a delegated subgroup), not by
# substring, so a same-prefix sibling cannot satisfy it.
pid_in_unit_cgroup() {
    [ -r "/proc/$1/cgroup" ] || return 1
    while IFS= read -r cgline; do
        case "$cgline" in
            *:"$2" | *:"$2"/*) return 0 ;;
        esac
    done < "/proc/$1/cgroup"
    return 1
}

# unit_main_pid_exe prints the absolute path of the binary xpfd.service is
# actually running, or nothing. MainPID is a structured integer property and
# /proc/<pid>/exe is a kernel symlink, so nothing here parses a rendered path.
#
# A pid is a NUMBER, though, and a number is not an identity (#6601 r4
# MAJOR-2). If xpfd.service exits between the MainPID read and the readlink and
# the kernel recycles that pid onto an unrelated process, /proc/<pid>/exe names
# that process's binary -- and this gate would then run it as the promotion
# authority. The basename guard alone does not close that; it only requires the
# recycled binary to be CALLED `xpfd`. So bind the pid back to the UNIT before
# believing it, and do the binding AFTER the readlink so a recycle that happens
# DURING the sequence is caught rather than raced past:
#
#   * membership in xpfd.service's OWN control group. systemd reports the
#     unit's cgroup as a structured property and the kernel reports each
#     process's cgroup in /proc/<pid>/cgroup, so this is an association the
#     kernel itself vouches for -- a recycled pid belongs to whatever cgroup
#     its new owner was forked into, not to this unit's. It also rejects an
#     unrelated same-numbered process seen through a mismatched /proc.
#   * MainPID re-read and still the SAME positive pid.
unit_main_pid_exe() {
    pid=$(systemctl show --property=MainPID --value "$PROMOTE_UNIT" 2>/dev/null) || return 0
    case "$pid" in
        '' | *[!0-9]*) return 0 ;;
    esac
    [ "$pid" -gt 0 ] || return 0
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 0
    case "$exe" in
        # A binary replaced on disk reads back as "<path> (deleted)". It cannot
        # be re-executed, so yield nothing rather than a mangled path. Stated
        # for clarity, not because it is load-bearing alone: that string also
        # fails the basename guard below and the regular-file admission test,
        # so no test claims this line is the sole rejector (#6601 r4 MINOR).
        *' (deleted)') return 0 ;;
    esac
    case "$exe" in
        # Basename guard. Every layout this gate supports names the artifact
        # `xpfd` (the manifest basename; flip writes <VersionsDir>/<ver>/xpfd
        # and <SbinDir>/xpfd), so this costs nothing.
        /*/xpfd) ;;
        *) return 0 ;;
    esac

    unitcg=$(systemctl show --property=ControlGroup --value "$PROMOTE_UNIT" 2>/dev/null) || return 0
    case "$unitcg" in
        /*) ;;
        *) return 0 ;;
    esac
    pid_in_unit_cgroup "$pid" "$unitcg" || return 0

    pid2=$(systemctl show --property=MainPID --value "$PROMOTE_UNIT" 2>/dev/null) || return 0
    [ "$pid2" = "$pid" ] || return 0

    printf '%s\n' "$exe"
}

# unit_exec_start prints the absolute path systemd launches xpfd.service from,
# or NOTHING.
#
# `systemctl show --property=ExecStart --value` renders each entry as
#
#     { path=/usr/sbin/sshd ; argv[]=/usr/sbin/sshd -D $OPTS ; ignore_errors=no ; ... }
#
# and the property printer substitutes the stored path RAW (`path=%s`), with no
# escaping. systemd PERMITS an executable path containing a space or a ';', so a
# parse that stops at the first one does not merely fail to resolve -- it
# resolves to a SHORTER, DIFFERENT path (#6601 r4: `path=/opt/relocated live/xpfd`
# yielded `/opt/relocated`, which the gate then executed as the promotion
# authority). Cut at the literal " ; argv[]=" systemd emits immediately after
# the field instead, and give up unless it occurs EXACTLY ONCE -- a second
# occurrence means the path (or an argument) contains the delimiter itself and
# no textual parse can recover the boundary.
#
# Multiple ExecStart entries render one per LINE. The shipped Type=simple unit
# cannot validly carry more than one, but an operator-overridden Type=oneshot
# can, and its FIRST entry need not be xpfd -- so more than one line is
# ambiguous, not "take the first".
#
# On a REAL multi-entry render the delimiter-count rule above already rejects
# the value (each entry carries its own " ; argv[]="), so the newline guard is
# not the sole rejector there and no test should claim it is (#6601 r4 MINOR).
# It is kept because it is the ONLY thing that rejects a render carrying just
# one delimiter across several lines, where the count rule passes and the parse
# would silently adopt the first entry.
unit_exec_start() {
    raw=$(systemctl show --property=ExecStart --value "$PROMOTE_UNIT" 2>/dev/null) || return 0
    [ -n "$raw" ] || return 0
    case "$raw" in
        *"$NL"*) return 0 ;;
    esac
    case "$raw" in
        '{ path='*"$ARGV_SEP"*)
            rest=${raw#'{ path='}
            case "${rest#*"$ARGV_SEP"}" in
                *"$ARGV_SEP"*) return 0 ;;
            esac
            path=${rest%%"$ARGV_SEP"*}
            ;;
        /*)
            # A bare (unstructured) rendering. Accepted ONLY when the whole
            # value is a single absolute path; arguments, or an @ / - / + / !
            # exec prefix, leave the executable unidentifiable. A prefix also
            # fails the `/*` match above and lands in the catch-all.
            #
            # Reject ANY whitespace, not just a space: a tab separates a path
            # from its arguments just as well, and "whole path only" has to be
            # true rather than approximately true (#6601 r4 audit note).
            # [[:space:]] covers space/tab/newline/CR/FF/VT and is honoured by
            # dash and busybox sh, the two shells this early-boot path runs
            # under.
            case "$raw" in
                *[[:space:]]* | *';'*) return 0 ;;
            esac
            path=$raw
            ;;
        *) return 0 ;;
    esac
    case "$path" in
        /*) printf '%s\n' "$path" ;;
    esac
}

# xpfd_unit_state echoes exactly one of:
#
#   known   -- systemd has an xpfd.service. Note this means known/LOADABLE
#              (LoadState loaded, masked, bad-setting, ...), NOT enabled and NOT
#              running -- which is the right test here: it says xpf IS installed
#              on this box, so an unlocatable binary is an operator-visible
#              fault.
#   absent  -- systemd answered "not-found". The benign "xpf is not on this box"
#              case, and the ONLY one that skips quietly.
#   unknown -- systemctl is missing, errored, or returned nothing. That proves
#              NOTHING about whether xpf is installed (#6601 r4), so it must not
#              be laundered into the benign skip: an armed candidate would sail
#              past the gate behind a reassuring log line.
xpfd_unit_state() {
    state=$(systemctl show --property=LoadState --value "$PROMOTE_UNIT" 2>/dev/null) || {
        echo unknown
        return 0
    }
    case "$state" in
        '') echo unknown ;;
        not-found) echo absent ;;
        *) echo known ;;
    esac
}

XPFD=""
XPFD_SRC=""

# usable: the admission test, applied identically to every candidate -- an
# existing, REGULAR, executable file (see the -f/-x note above).
usable() {
    [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ]
}

try_candidate() {
    [ -z "$XPFD" ] || return 0
    usable "$1" || return 0
    XPFD="$1"
    XPFD_SRC="$2"
}

try_candidate "$(unit_main_pid_exe)" "systemd MainPID -> /proc/<pid>/exe for xpfd.service"
try_candidate "$(unit_exec_start)" "systemd ExecStart for xpfd.service"

# No further source. See "THERE IS DELIBERATELY NO STEP 4" above: any candidate
# derived from the filesystem alone can be satisfied by a leftover that
# relocation did not remove, so there is nothing left to try that would be an
# answer rather than a guess.
#
# Both refusals below exit 0 DELIBERATELY: they take the same non-rebooting
# infra-error path as an rc=1 from the gate, because the firmware already
# cleared BootNext and the next plain reboot falls back to known-good. A
# non-zero exit would trip OnFailure= and reboot the box over what may be a
# transient packaging window.
if [ -z "$XPFD" ]; then
    # Gather the FACTS before deciding what to say. The refusal is now the only
    # operator-visible signal this gate produces -- exit 0 keeps the unit
    # `active` and `systemctl status xpf-kernel-promote` reads SUCCESS -- so the
    # journal line has to carry what systemd actually returned, not just policy
    # (#6601 r5 MINOR-2). Facts are captured with the SAME queries the discovery
    # functions used, so what is printed is what was decided on.
    unit_state=$(xpfd_unit_state)
    mainpid_raw=$(systemctl show --property=MainPID --value "$PROMOTE_UNIT" 2>/dev/null) || mainpid_raw="<systemctl failed>"
    loadstate_raw=$(systemctl show --property=LoadState --value "$PROMOTE_UNIT" 2>/dev/null) || loadstate_raw="<systemctl failed>"
    execstart_raw=$(systemctl show --property=ExecStart --value "$PROMOTE_UNIT" 2>/dev/null) || execstart_raw="<systemctl failed>"
    facts="unit=$PROMOTE_UNIT LoadState=[${loadstate_raw}] MainPID=[${mainpid_raw}] ExecStart=[${execstart_raw}]"

    if [ "$unit_state" = absent ]; then
        # NOT a reassuring "skipping" line. The deb that installs THIS script
        # also installs xpfd.service (debian/rules), so systemd reporting it
        # not-found on a box running this gate means it was removed or renamed
        # -- e.g. a standalone box cut with `xpfd upgrade cut --unit myxpf`,
        # where flip maintains myxpf.service instead. On such a box an ARMED
        # candidate would otherwise sail past unverified behind a log line that
        # read like everything was fine (#6601 r5 MINOR-1).
        #
        # Arming is refused up front on this layout (CheckKernelPromotionUnit),
        # so reaching here means the unit was renamed or removed AFTER arming,
        # or the candidate was armed by an older build. Either way, say plainly
        # that the gate did not run and name exactly what was looked for.
        log "WARNING: the promotion gate did NOT run. It derives the live xpfd" \
            "from the systemd unit ${PROMOTE_UNIT} specifically, and systemd" \
            "reports that unit not-found ($facts). This gate does NOT infer" \
            "which unit is the xpf one -- that guess is the failure class it" \
            "exists to eliminate. If this host runs xpfd under a different unit" \
            "(\`xpfd upgrade cut --unit <name>\`), the kernel channel does not" \
            "support that layout and \`xpfd upgrade kernel arm\` refuses it. If" \
            "a candidate kernel IS armed right now it is running UNVERIFIED and" \
            "will NOT be promoted; the next plain reboot falls back to the" \
            "known-good slot."
        exit 0
    fi
    # FAIL LOUD, do not fail silent. Either xpf IS installed here or systemd
    # could not be consulted at all -- and neither proves this box is xpf-free.
    # Being unable to locate the binary means the gate cannot run, and an armed
    # candidate would otherwise sail past unverified with nothing in the journal
    # to say so.
    # Branch the ADVICE on which cause actually fired. Telling an operator to
    # "fix ExecStart" when systemctl could not be consulted at all is worse
    # than useless -- it points at the wrong system (#6601 r5 MINOR-2).
    if [ "$unit_state" = unknown ]; then
        cause="systemctl could not be consulted at all (missing, errored, or it"
        cause="$cause returned nothing), so NOTHING is known about whether xpf is"
        cause="$cause installed here"
        advice="Check that systemd is running and systemctl works in this boot"
        advice="$advice (\`systemctl show --property=LoadState ${PROMOTE_UNIT}\`);"
        advice="$advice this is a systemd-availability problem, NOT an"
        advice="$advice xpfd.service configuration problem"
    else
        cause="${PROMOTE_UNIT} IS known to systemd (LoadState=${loadstate_raw}),"
        cause="$cause so xpf IS installed here, but its MainPID does not resolve"
        cause="$cause to an xpfd this unit owns and its ExecStart does not name"
        cause="$cause one unambiguously"
        advice="Fix ${PROMOTE_UNIT} so its ExecStart names the live xpfd as a"
        advice="$advice single unambiguous absolute path, then re-arm"
    fi
    log "ERROR: cannot locate the xpfd binary. $cause. FACTS: $facts." \
        "REFUSING to promote: this gate does NOT fall back to guessing a path," \
        "because a runtime left behind by --versions-dir/--sbin-dir relocation" \
        "is indistinguishable from a live one and executing the stale half" \
        "would verify the candidate kernel against the wrong dataplane. The" \
        "armed candidate stays un-promoted and the next plain reboot falls back" \
        "to the known-good slot. $advice."
    exit 0
fi

log "promotion gate: using $XPFD ($XPFD_SRC)"

"$XPFD" upgrade kernel promote
rc=$?

case "$rc" in
    0)
        log "promotion gate: clean (promoted or ordinary boot)"
        exit 0
        ;;
    3)
        log "promotion gate: REVERT — candidate failed; rebooting to known-good slot"
        # The firmware already consumed BootNext and revert() restored the
        # known-good slot to the BootOrder front, so this reboot lands on
        # known-good. Use --no-wall; this is an unattended recovery reboot.
        systemctl reboot --no-wall || reboot
        # Exit 0: issuing the recovery reboot IS the intended outcome of a
        # revert, so the unit must NOT record failure here — otherwise OnFailure=
        # (the hang/timeout recovery) would double-fire a second reboot. The
        # OnFailure handler is reserved for the case where this script never
        # reaches its own reboot (SIGTERM on TimeoutStartSec).
        exit 0
        ;;
    *)
        log "promotion gate: infra error (rc=$rc); NOT rebooting (avoid a bounce loop) — candidate is un-promoted, next plain reboot falls back to known-good"
        exit 0
        ;;
esac
