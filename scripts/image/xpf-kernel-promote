#!/bin/sh
# xpf (#1930) — LANE-1 kernel-channel promotion gate (runs on EVERY boot).
#
# This is the early-boot half of the A4 channel (r1 Codex Critical-1: the gate
# must actually be invoked, and a REVERT must actually reboot). On an ordinary
# boot (no candidate armed) `xpfd upgrade kernel promote` is a fast no-op. On a
# candidate trial boot it runs the gate (BootCurrent==candidate slot + uname ==
# candidate + verify-dataplane PASS + forward beacon PASS):
#   exit 0 -> PROMOTED (durable BootOrder reorder already done) — continue boot.
#   exit 3 -> REVERTED (candidate failed the gate) — reboot NOW; the firmware
#             already cleared BootNext, so the reboot falls through BootOrder to
#             the known-good slot (revert() also restored it).
#   exit 1/other -> infra error — do NOT reboot-loop on a transient failure;
#             log and continue this boot (the candidate is running but
#             un-promoted, so the NEXT plain reboot still falls back to
#             known-good via the firmware-cleared BootNext). Leave the box
#             usable for diagnosis rather than bouncing it.
#
# It runs AFTER xpfd is up (the forward-beacon gate pings through the dataplane,
# which needs xpfd active) but is NOT a hard ordering dependency of xpfd (a stuck
# promote must never wedge the box): see the .service. The promotion is gated on
# verify-dataplane (the #1864 kernel verifier — structural) AND a real forward
# beacon (off-box reachability through the dataplane), so a candidate that boots
# + verifies but cannot forward is reverted, not promoted.

set -u
log() { echo "xpf-kernel-promote: $*" >&2; }

# Resolve xpfd by EXPLICIT path, never through $PATH (#6541). This is the OUTER
# hop of the promote gate: it runs as root from a systemd oneshot on a candidate
# boot and its exit status decides promote-vs-rollback, so a $PATH entry ordered
# ahead of the real location must not be able to author that decision — and even
# absent an attacker, a stale xpfd left in another PATH directory would verify
# the wrong build against the candidate kernel. (The inner hop, xpfd's own
# `verify-dataplane` exec, is resolved explicitly by resolveVerifyGateBin in
# pkg/upgrade/kernel_linux.go.)
#
# DISCOVERY, then compiled defaults, then a LOUD refusal. Never $PATH.
#
#   1. The ExecStart systemd has for xpfd.service. This is the authority: it is
#      the path systemd actually launches the live daemon from, and it is
#      exactly what the cut writes -- flip step 6c templates
#      ExecStart=<VersionsDir>/<ver>/xpfd into 10-xpf-version.conf on every cut
#      (pkg/upgrade/flip.go), and the shipped base unit carries
#      ExecStart=/usr/local/sbin/xpfd before the first cut. So it names the live
#      binary both pre- and post-cut, and it is a CONCRETE ABSOLUTE PATH that
#      depends on no compiled-in root.
#
#      That last property is the point. `--versions-dir` AND `--sbin-dir` are
#      both real operator options (cmd/xpfd/upgrade.go) and the cut maintains
#      whatever was configured. A gate that knows only the compiled defaults
#      breaks on a box that relocated BOTH -- e.g. --versions-dir=/opt/xpf/versions
#      with --sbin-dir=/usr/sbin, where /usr/sbin/xpfd is perfectly intact and
#      merely is not one of our hardcoded paths. It would then either skip an
#      ARMED promotion gate or, with a leftover default runtime, exec a STALE
#      build that can reject a healthy candidate and trigger a needless revert.
#      Asking systemd removes the guesswork instead of adding a third guess.
#
#   2. /usr/local/sbin/xpfd -- compiled-default managed entry point.
#   3. /var/lib/xpf/versions/current/xpfd -- compiled-default runtime root.
#
#      (2) and (3) are for a box where systemd cannot answer (no unit yet, a
#      systemctl that does not understand the query). (2) outranks (3) because
#      the cut repoints the sbin entry to the CONFIGURED runtime root, so it
#      stays right under `--versions-dir` relocation, whereas (3) is correct
#      only on a default-rooted box AND is not removed when the operator
#      relocates -- consulting it first would select a stale build.
#
# `-f` as well as `-x`: `test -x` is TRUE for a searchable DIRECTORY, and the
# inner hop's validateGateBin rejects a non-regular target, so both hops apply
# the same admission test rather than only claiming to. `-f` also rejects a
# DANGLING symlink, the #2176 case that hands over to the next candidate.
#
# systemctl itself is $PATH-resolved, which is correct: it is a
# distribution-owned binary, unlike xpfd.

# unit_exec_start prints the absolute path systemd launches xpfd.service from,
# or nothing. `systemctl show -p ExecStart` renders a structured value
# (`{ path=/x ; argv[]=... }`); older/newer renderings are tolerated by pulling
# the first `path=` field, with a bare-absolute-path fallback.
unit_exec_start() {
    raw=$(systemctl show --property=ExecStart --value xpfd.service 2>/dev/null) || return 0
    path=$(printf '%s\n' "$raw" | sed -n 's/.*path=\([^ ;]*\).*/\1/p' | head -n 1)
    if [ -z "$path" ]; then
        path=$(printf '%s\n' "$raw" | sed -n 's/^\(\/[^ ;]*\).*/\1/p' | head -n 1)
    fi
    [ -n "$path" ] && printf '%s\n' "$path"
}

# xpfd_unit_known reports whether systemd knows an xpfd.service at all. Used
# only to decide how LOUD to be when nothing resolves: a loaded unit means xpf
# is installed and an unlocatable binary is an operator-visible fault, not the
# benign "xpf is not on this box" case.
xpfd_unit_known() {
    state=$(systemctl show --property=LoadState --value xpfd.service 2>/dev/null) || return 1
    [ -n "$state" ] && [ "$state" != "not-found" ]
}

XPFD=""
XPFD_SRC=""
try_candidate() {
    [ -z "$XPFD" ] || return 0
    [ -n "$1" ] || return 0
    if [ -f "$1" ] && [ -x "$1" ]; then
        XPFD="$1"
        XPFD_SRC="$2"
    fi
}

try_candidate "$(unit_exec_start)" "systemd ExecStart for xpfd.service"
try_candidate /usr/local/sbin/xpfd "compiled-default sbin entry"
try_candidate /var/lib/xpf/versions/current/xpfd "compiled-default versioned runtime"

if [ -z "$XPFD" ]; then
    if xpfd_unit_known; then
        # FAIL LOUD, do not fail silent. xpf IS installed here, so being unable
        # to locate its binary means the gate cannot run -- and an armed
        # candidate would otherwise sail past unverified with nothing in the
        # journal to say so. Exit 0 deliberately: this takes the same
        # non-rebooting infra-error path as an rc=1 from the gate, because the
        # firmware already cleared BootNext and the next plain reboot falls back
        # to known-good. A non-zero exit would trip OnFailure= and reboot the
        # box over what may be a transient packaging window.
        log "ERROR: cannot locate the xpfd binary (systemd ExecStart for" \
            "xpfd.service, /usr/local/sbin/xpfd, /var/lib/xpf/versions/current/xpfd" \
            "all unusable) but xpfd.service IS installed. REFUSING to promote:" \
            "an armed candidate stays un-promoted and the next plain reboot" \
            "falls back to the known-good slot. If this host relocated its" \
            "runtime with --versions-dir/--sbin-dir, ensure xpfd.service's" \
            "ExecStart names the live binary."
        exit 0
    fi
    log "xpfd not found and no xpfd.service is installed; skipping promotion gate"
    exit 0
fi

log "promotion gate: using $XPFD ($XPFD_SRC)"

"$XPFD" upgrade kernel promote
rc=$?

case "$rc" in
    0)
        log "promotion gate: clean (promoted or ordinary boot)"
        exit 0
        ;;
    3)
        log "promotion gate: REVERT — candidate failed; rebooting to known-good slot"
        # The firmware already consumed BootNext and revert() restored the
        # known-good slot to the BootOrder front, so this reboot lands on
        # known-good. Use --no-wall; this is an unattended recovery reboot.
        systemctl reboot --no-wall || reboot
        # Exit 0: issuing the recovery reboot IS the intended outcome of a
        # revert, so the unit must NOT record failure here — otherwise OnFailure=
        # (the hang/timeout recovery) would double-fire a second reboot. The
        # OnFailure handler is reserved for the case where this script never
        # reaches its own reboot (SIGTERM on TimeoutStartSec).
        exit 0
        ;;
    *)
        log "promotion gate: infra error (rc=$rc); NOT rebooting (avoid a bounce loop) — candidate is un-promoted, next plain reboot falls back to known-good"
        exit 0
        ;;
esac
