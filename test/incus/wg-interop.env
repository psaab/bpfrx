# #1736 S2b — live kernel-WireGuard interop harness constants.
# Sourced by test/incus/wg-interop.sh. All values match the converged
# research plan docs/pr/1736-wg-interop/plan.md (Path A).

# Shared loss userspace cluster (canonical smoke environment).
WG_REMOTE="loss"
WG_FW0="xpf-userspace-fw0"
WG_FW1="xpf-userspace-fw1"
WG_LAN_HOST="cluster-userspace-host"

# The kernel-WireGuard reference peer instance (Debian-13 VM).
# Naming: xpf-wg-* per the S2b scope so strays are identifiable.
WG_PEER="xpf-wg-peer"
WG_PEER_DATA_PARENT="mlx1"     # SR-IOV parent for the data NIC
WG_PEER_DATA_VLAN="3667"       # LAN VLAN (mirrors cluster-userspace-host)
WG_PEER_MGMT_NET="incusbr0"    # mgmt NIC bridge (apt + agent reachability)

# LAN addressing (VLAN 3667). .102 = cluster-userspace-host, .1 = xpf VIP.
WG_PEER_LAN4="10.0.61.103/24"
WG_PEER_LAN6="2001:559:8585:ef00::103/64"
WG_XPF_OUTER4="10.0.61.1"      # xpf WG outer endpoint = LAN VIP (node0 primary)

# WireGuard outer transport.
WG_LISTEN_PORT="51820"
WG_KERNEL_IFACE="wgref"        # kernel wg device name on the peer
WG_PEER_KEEPALIVE="25"

# Inner tunnel addressing.
WG_INNER4_XPF="10.78.0.1"
WG_INNER4_PEER="10.78.0.2"
WG_INNER4_CIDR="10.78.0.0/24"
WG_INNER6_XPF="fd00:78::1"
WG_INNER6_PEER="fd00:78::2"
WG_INNER6_CIDR="fd00:78::/64"

# Fast-path no-regress smoke targets (canonical VLAN-80 path).
WG_IPERF_TARGET4="172.16.80.200"
WG_IPERF_TARGET6="2001:559:8585:80::200"

# Timing budgets (plan §5.2).
WG_HANDSHAKE_TIMEOUT_S="15"    # P1/P3 handshake deadline
WG_SETTLE_S="5"                # transport settle before loss-counting pings
WG_P4A_DURATION_S="220"        # expiry-driven recovery run (>= 210)
WG_P4B_DURATION_S="185"        # seamless initiator-rekey run (>= 180)
WG_P4A_MAX_GAP_S="10"          # max tolerated outage around REJECT_AFTER_TIME
WG_RESTART_RECOVER_S="30"      # P6 post-flush recovery deadline
WG_TUNNEL_IPERF_FLOOR_MBPS="50" # P2 breakage floor (NOT a perf gate)

# Shared-cluster discipline.
WG_CLUSTER_LOCK="/tmp/xpf-cluster.lock"

# Peer instance type: "vm" (issue-literal) or "container" (plan §4
# fallback — kernel wg in the host kernel's netns; used when fresh VMs
# cannot bring up the incus-agent on the loss host).
WG_PEER_TYPE="${WG_PEER_TYPE:-vm}"
